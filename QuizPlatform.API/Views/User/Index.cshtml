@model IEnumerable<QuizPlatform.API.Models.Entity.User>

@{
    ViewBag.Title = "Daftar User";
}

<h2>Daftar User</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nama</th>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Username</td>
                <td>@item.Email</td>
                <td>@item.IsActive</td>
            </tr>
        }
    </tbody>
</table>